      "id": "dea89342-6c47-4a5e-9c15-0f9943789d89",
      "name": "Get Deal IDs"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst ids = response.result?.deals;\n\nif (!Array.isArray(ids)) {\n  throw new Error('API не вернул список ID сделок в result.deals');\n}\n\nreturn ids.map(id => ({\n  json: {\n    id: Number(id)\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "db89ab89-2619-4817-86cc-5b3abbc022b5",
      "name": "Split Deal IDs"
    },
    {
      "parameters": {
        "url": "={{ $('API Configuration').first().json.apiBase + $('API Configuration').first().json.detailPath }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "={{ $json.id }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        896,
        0
      ],
      "id": "157994ec-aea8-4636-98d9-ebf073919b80",
      "name": "Get Deal Details",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const responses = $input.all();\nconst sourceItems = $(\"Split Deal IDs\").all();\n\nconst data = [];\nconst errors = [];\n\nfor (let i = 0; i < responses.length; i++) {\n  const response = responses[i].json;\n  const id = sourceItems[i]?.json?.id ?? null;\n\n  const deal = response?.result;\n\n  if (deal && deal.id !== undefined) {\n    data.push({\n      id: deal.id,\n      title: deal.title ?? '',\n      amount: deal.amount ?? null,\n      responsible: {\n        id: deal.responsible?.id ?? null,\n        name: deal.responsible?.name ?? ''\n      },\n      company: {\n        id: deal.company?.id ?? null,\n        name: deal.company?.name ?? ''\n      }\n    });\n  } else {\n    errors.push({\n      id: id,\n      message:\n        response?.error ??\n        response?.message ??\n        `Не удалось получить данные сделки ${id}`\n    });\n  }\n}\n\nreturn [\n  {\n    json: {\n      success: errors.length === 0,\n      total: data.length,\n      data,\n      errors\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
