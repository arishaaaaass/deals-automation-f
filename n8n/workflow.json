      "name": "Get Deal IDs",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const deals = $json.result.deals ?? [];\n\nreturn deals.map(id => ({\n  json: {\n    id\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "db89ab89-2619-4817-86cc-5b3abbc022b5",
      "name": "Split Deal IDs"
    },
