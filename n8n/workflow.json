        896,
        0
      ],
      "id": "157994ec-aea8-4636-98d9-ebf073919b80",
      "name": "Get Deal Details",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst sourceItems = $('Split Deal IDs').all();\n\nconst deals = [];\nconst errors = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const value = items[i].json;\n\n  if (value.result && value.result.id) {\n    const deal = value.result;\n\n    deals.push({\n      id: deal.id,\n      title: deal.title,\n      amount: deal.amount,\n      responsible: {\n        id: deal.responsible?.id ?? null,\n        name: deal.responsible?.name ?? null\n      },\n      company: {\n        id: deal.company?.id ?? null,\n        name: deal.company?.name ?? null\n      }\n    });\n\n  } else {\n    const sourceId = sourceItems[i]?.json?.id ?? null;\n\n    errors.push({\n      id: value.id ?? sourceId,\n      message:\n        value.error?.message ??\n        value.error ??\n        value.message ??\n        'Failed to load deal details'\n    });\n  }\n}\n\nreturn [\n  {\n    json: {\n      success: true,\n      partial: errors.length > 0,\n      total: deals.length,\n      deals,\n      errors\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
